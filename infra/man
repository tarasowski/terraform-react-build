resource "null_resource" "build_frontend" {
  triggers = {
    always_run = timestamp()
  }
  provisioner "local-exec" {
    command = <<EOT
    echo "The build step starts...."
    cd ../app
    npm install
    npm run build
    while [ ! -f "../app/dist/build_complete.lock" ]; 
    do sleep 1; 
    done
    echo "The build step is finished..."
    EOT
  }
}

